---
# Generated by `docex compile`. Do not edit by hand.
# project: {{ project }} v{{ project_version }}
# env: {{ env }}
- name: Deploy {{ project }} {{ env }}
  hosts: {{ env }}
  become: true
  vars:
    project: "{{ project }}"
    env: "{{ env }}"
    version: "{{ project_version }}"
    deploy_root: "/opt/{{ project }}/{{ env }}"
  tasks:
    - name: Ensure deploy directory exists
      ansible.builtin.file:
        path: "{{ '{{' }} deploy_root {{ '}}' }}"
        state: directory
        mode: "0750"

    - name: Render docker-compose.yml onto host
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/../{{ env }}/docker-compose.yml"
        dest: "{{ '{{' }} deploy_root {{ '}}' }}/docker-compose.yml"
        mode: "0640"

    - name: Render .env onto host
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/../../secrets/{{ env }}.env"
        dest: "{{ '{{' }} deploy_root {{ '}}' }}/.env"
        mode: "0600"

    - name: Pull all images
      community.docker.docker_compose_v2:
        project_src: "{{ '{{' }} deploy_root {{ '}}' }}"
        pull: always
        state: present
{% for svc in core_services_with_schema %}
    - name: Run migrations for {{ svc.name }}
      ansible.builtin.command:
        cmd: docker compose run --rm {{ svc.name }} /service/migrate.sh
        chdir: "{{ '{{' }} deploy_root {{ '}}' }}"
      register: {{ svc.name }}_migrate_result
      changed_when: true
      tags:
        - migrate
{% endfor %}
    - name: Bring up the stack
      community.docker.docker_compose_v2:
        project_src: "{{ '{{' }} deploy_root {{ '}}' }}"
        state: present
        remove_orphans: true
