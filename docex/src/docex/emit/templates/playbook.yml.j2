---
# Generated by `docex compile`. Do not edit by hand.
# project: {{ project }} v{{ project_version }}
# env: {{ env }}
- name: Deploy {{ project }} {{ env }}
  hosts: {{ env }}
  become: true
  vars:
    project: "{{ project }}"
    env: "{{ env }}"
    version: "{{ project_version }}"
    deploy_root: "/opt/{{ project }}/{{ env }}"
  tasks:
    - name: Ensure deploy directory exists
      ansible.builtin.file:
        path: "{{ '{{' }} deploy_root {{ '}}' }}"
        state: directory
        mode: "0750"

    - name: Render docker-compose.yml onto host
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/../{{ env }}/docker-compose.yml"
        dest: "{{ '{{' }} deploy_root {{ '}}' }}/docker-compose.yml"
        mode: "0640"

    - name: Render TTE store onto host
      ansible.builtin.copy:
        src: "{{ '{{' }} tte_store_file {{ '}}' }}"
        dest: "{{ '{{' }} deploy_root {{ '}}' }}/tte.env"
        mode: "0600"
      # Skipped in dry-run (--check passes no extra-vars); the real release
      # always supplies tte_store_file. Mod 093.
      when: tte_store_file is defined

    - name: Render .env onto host
      ansible.builtin.copy:
        src: "{{ '{{' }} agg_env_file {{ '}}' }}"
        dest: "{{ '{{' }} deploy_root {{ '}}' }}/.env"
        mode: "0600"
      # Skipped in dry-run (--check passes no extra-vars); the real release
      # always supplies agg_env_file. Mod 093.
      when: agg_env_file is defined

    - name: Pull all images
      community.docker.docker_compose_v2_pull:
        project_src: "{{ '{{' }} deploy_root {{ '}}' }}"
        project_name: "{{ compose_project_name }}"
        policy: always
{% for svc in migrations %}
    - name: Run migrations for {{ svc.codebase }}
      ansible.builtin.command:
        cmd: docker compose -p {{ compose_project_name }} run --rm {{ svc.exec_service }} /service/migrate.sh
        chdir: "{{ '{{' }} deploy_root {{ '}}' }}"
      register: {{ svc.codebase }}_migrate_result
      changed_when: true
      tags:
        - migrate
{% endfor %}
    - name: Bring up the stack
      community.docker.docker_compose_v2:
        project_src: "{{ '{{' }} deploy_root {{ '}}' }}"
        project_name: "{{ compose_project_name }}"
        state: present
        remove_orphans: true
