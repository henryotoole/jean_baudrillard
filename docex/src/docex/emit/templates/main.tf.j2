{# Mod 060: render the standard three-block tags (cicl.md § Naming and
   Tagging). `tags` is the ordered dict from the `standard_tags` global. -#}
{%- macro tagblock(tags) -%}
{{ "  tags = {" }}
{%- for k, v in tags.items() %}
    {{ k }} = "{{ v }}"
{%- endfor %}
  }
{%- endmacro -%}
{# Top-of-file header. -#}
# Generated by `docex compile`. Do not edit by hand.
# project: {{ project }} v{{ project_version }}
# env: {{ env }} (foundation: elastic)
# apex_domain: {{ apex_domain }} -> {{ subdomain }}

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  # State backend reference (provisioned by `docex projinfra up production`).
  backend "s3" {
    bucket         = "{{ state_bucket }}"
    key            = "{{ env }}/terraform.tfstate"
    region         = "{{ region }}"
    dynamodb_table = "{{ state_lock_table }}"
    encrypt        = true
  }
}

provider "aws" {
  region = "{{ region }}"
}

# AWS account ID — used downstream for SSM parameter ARNs in ECS
# secrets[] blocks. Resolved at apply time so `docex compile` stays
# offline-pure (no AWS creds required for compile).
data "aws_caller_identity" "current" {}

# ---------------------------------------------------------------------------
# Project-tier outputs (VPC, subnets, Route53 zone, ACM cert, ECR repos).
# Provisioned once by `docex projinfra up production` against ../project/production/main.tf;
# the env-tier apply just composes them.
# ---------------------------------------------------------------------------
data "terraform_remote_state" "project" {
  backend = "s3"
  config = {
    bucket = "{{ state_bucket }}"
    key    = "project/terraform.tfstate"
    region = "{{ region }}"
  }
}

# ---------------------------------------------------------------------------
# Network plane (security groups; one per CICL-declared network)
# ---------------------------------------------------------------------------
{% for short in networks_sorted -%}
resource "aws_security_group" "{{ short }}" {
  # WHY: data-plane name per networks.md § Compiled Names — hyphenated form
  # regardless of the project's underscore form.
  name        = "{{ project_dns_label }}-{{ env }}-{{ short }}"
  description = "{{ short }} network for {{ project }} {{ env }}"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
  # WHY: aws_security_group denies egress when no egress block is given,
  # overriding AWS's allow-all default. Without this, Fargate tasks can't
  # reach SSM/ECR. Per-network egress restriction is deferred — see
  # infrastructure.md § Deferred rule 6.
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
{# Mod 060: network SG is env-scoped (service/role=etc); the network short
   name now rides in `descriptor` (was the bespoke `network` tag). -#}
{{ tagblock(standard_tags("environment", shape_name="network", descriptor=short, project=project, env=env, codebase="etc", role="etc")) }}
}
{% if short == "web" %}
# Web SG: open ingress only from the project reverse-proxy SG (project-tier).
# Mod 044: source SG is polymorphic — `alb` projects use the project ALB's SG,
# `ec2_traefik_*` projects use the project's traefik EC2 SG. Both expose the
# value via the project-tier `reverse_proxy_security_group_id` output.
resource "aws_security_group_rule" "{{ short }}_ingress_from_reverse_proxy" {
  type                     = "ingress"
  from_port                = 0
  to_port                  = 65535
  protocol                 = "tcp"
  security_group_id        = aws_security_group.{{ short }}.id
  source_security_group_id = data.terraform_remote_state.project.outputs.reverse_proxy_security_group_id
}
{% else %}
# Internal SG: accepts ingress only from itself (services in the same network).
resource "aws_security_group_rule" "{{ short }}_self_ingress" {
  type              = "ingress"
  from_port         = 0
  to_port           = 65535
  protocol          = "tcp"
  security_group_id = aws_security_group.{{ short }}.id
  self              = true
}
{% endif %}
{% endfor %}

# ---------------------------------------------------------------------------
# ECS cluster — provisioned at the PROJECT tier (mod 071), not here. Both the
# stage and prod clusters always exist; this env references its own via
# `data.terraform_remote_state.project.outputs.ecs_cluster_<env>_arn`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Service discovery — ECS Service Connect over a Cloud Map PRIVATE DNS
# namespace. Per shape.md § Elastic-Foundation, one namespace per env,
# associated with the master VPC. The namespace provides mesh-internal
# Service Connect resolution ONLY: ECS tasks inside the namespace resolve
# each other by discoveryName via the Envoy sidecar. It is NOT how the
# EC2-traefik reverse proxy (mod 044) finds backends — that path discovers
# RUNNING tasks and their routing labels through its ECS provider (mod 070),
# not through this DNS zone. See the ec2_traefik projinfra doc.
# ---------------------------------------------------------------------------
resource "aws_service_discovery_private_dns_namespace" "env" {
  # Mod 046: Cloud Map private DNS namespaces resolve via Route53; the name
  # must be a valid DNS hostname, so the project segment is DNS-labeled
  # (underscores → hyphens, lowercased) — the joiner is already a hyphen
  # per mod 040, but underscores inside an underscored project name would
  # survive without this filter and AWS would reject the resource.
  name        = "{{ project_dns_label }}-{{ env }}"
  vpc         = data.terraform_remote_state.project.outputs.vpc_id
  description = "ECS Service Connect namespace for {{ project_dns_label }} {{ env }}"
{{ tagblock(standard_tags("environment", shape_name="service_discovery", descriptor="namespace", project=project, env=env, codebase="etc", role="etc")) }}
}

# ---------------------------------------------------------------------------
# Services (backing first, then core; dispatch is by engine.emits.elastic).
# Per Mod 013, both backing and core services flow through the same
# destination-driven renderer — what HCL gets emitted is governed by the
# engine's declared emit destinations.
# ---------------------------------------------------------------------------
{% for svc in services -%}
{{ render_service(svc) }}

{% endfor %}
{% if migrations_hcl %}
# ---------------------------------------------------------------------------
# Migration task definitions (Mod 099): one per schema-owning CODEBASE, not
# per core service. Emitted here rather than inside the per-service loop
# because migration is a per-codebase operation — `docex migrate` and the
# release's targeted pre-migrate apply both address `<codebase>_migrate`.
# ---------------------------------------------------------------------------
{{ migrations_hcl }}

{% endif %}

{% if reverse_proxy == "alb" %}
# ---------------------------------------------------------------------------
# Route53 record: <env-subdomain> -> project ALB (project-tier; mod 038)
#
# Mod 044: gated on `reverse_proxy == "alb"`. EC2-traefik projects emit
# these five-host A-records at the project tier instead (the records all
# converge on the single traefik instance regardless of env).
# ---------------------------------------------------------------------------
resource "aws_route53_record" "env" {
  zone_id = data.terraform_remote_state.project.outputs.zone_id
  name    = "{{ subdomain }}"
  type    = "A"
  alias {
    name                   = data.terraform_remote_state.project.outputs.alb_dns_name
    zone_id                = data.terraform_remote_state.project.outputs.alb_zone_id
    evaluate_target_health = false
  }
}

# Per-service subdomains (<service>.{{ subdomain }}) all resolve to the
# same ALB; the listener rules dispatch by host header. One wildcard record
# covers every web service in this env.
resource "aws_route53_record" "env_wildcard" {
  zone_id = data.terraform_remote_state.project.outputs.zone_id
  name    = "*.{{ subdomain }}"
  type    = "A"
  alias {
    name                   = data.terraform_remote_state.project.outputs.alb_dns_name
    zone_id                = data.terraform_remote_state.project.outputs.alb_zone_id
    evaluate_target_health = false
  }
}

{% if env == "prod" %}
# Bare-project A-record: <project>.<apex_domain> -> project ALB. Per
# `cicl.md § Domain`, the bare-project host routes to prod's
# `domain_default_service` for user-URL ergonomics (replacing the old
# `www.<apex>` convention). Only emitted on prod since the bare-project
# resolves to prod's default service regardless. Mod 048 added this
# alongside the env subdomain + wildcard records; the listener rules
# already include the bare-project host in their `host_header` values
# (the compiler's `_web_hosts` does that on prod), so the ALB routes
# correctly the moment the A-record exists.
resource "aws_route53_record" "bare_project" {
  zone_id = data.terraform_remote_state.project.outputs.zone_id
  name    = "{{ bare_project_subdomain }}"
  type    = "A"
  alias {
    name                   = data.terraform_remote_state.project.outputs.alb_dns_name
    zone_id                = data.terraform_remote_state.project.outputs.alb_zone_id
    evaluate_target_health = false
  }
}
{% endif %}
{% endif %}
