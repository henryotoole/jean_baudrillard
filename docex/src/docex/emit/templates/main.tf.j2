{# Top-of-file header. -#}
# Generated by `docex compile`. Do not edit by hand.
# project: {{ project }} v{{ project_version }}
# env: {{ env }} (foundation: elastic)
# domain: {{ domain }} -> {{ subdomain }}

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  # State backend reference (provisioned by `docex bootstrap`).
  backend "s3" {
    bucket         = "{{ project }}-tofu-state"
    key            = "{{ env }}/terraform.tfstate"
    region         = "{{ region }}"
    dynamodb_table = "{{ project }}-tofu-locks"
    encrypt        = true
  }
}

provider "aws" {
  region = "{{ region }}"
}

# AWS account ID — used downstream for SSM parameter ARNs in ECS
# secrets[] blocks. Resolved at apply time so `docex compile` stays
# offline-pure (no AWS creds required for compile).
data "aws_caller_identity" "current" {}

# ---------------------------------------------------------------------------
# Project-tier resources (VPC, ECR, Route53, ACM) referenced by data sources.
# These are emitted into ../project/main.tf in a future phase; here we use
# data-source lookups so the env-tier HCL can reference them.
# ---------------------------------------------------------------------------
data "aws_vpc" "project" {
  tags = {
    project = "{{ project }}"
  }
}

data "aws_subnets" "private" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.project.id]
  }
  tags = {
    project = "{{ project }}"
    tier    = "private"
  }
}

data "aws_subnets" "public" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.project.id]
  }
  tags = {
    project = "{{ project }}"
    tier    = "public"
  }
}

data "aws_route53_zone" "project" {
  name = "{{ domain }}"
}

data "aws_acm_certificate" "project" {
  domain      = "*.{{ domain }}"
  most_recent = true
}

# ---------------------------------------------------------------------------
# Network plane (security groups; one per CICL-declared network)
# ---------------------------------------------------------------------------
{% for short in networks_sorted -%}
resource "aws_security_group" "{{ short }}" {
  name        = "{{ project }}_{{ env }}_{{ short }}"
  description = "{{ short }} network for {{ project }} {{ env }}"
  vpc_id      = data.aws_vpc.project.id
  tags = {
    project    = "{{ project }}"
    env        = "{{ env }}"
    network    = "{{ short }}"
    managed_by = "doctrine"
  }
}
{% if short == "web" %}
# Web SG: open ingress only from the ALB SG.
resource "aws_security_group_rule" "{{ short }}_ingress_from_alb" {
  type                     = "ingress"
  from_port                = 0
  to_port                  = 65535
  protocol                 = "tcp"
  security_group_id        = aws_security_group.{{ short }}.id
  source_security_group_id = aws_security_group.alb.id
}
{% else %}
# Internal SG: accepts ingress only from itself (services in the same network).
resource "aws_security_group_rule" "{{ short }}_self_ingress" {
  type              = "ingress"
  from_port         = 0
  to_port           = 65535
  protocol          = "tcp"
  security_group_id = aws_security_group.{{ short }}.id
  self              = true
}
{% endif %}
{% endfor %}

# ALB security group (allows public 443/80).
resource "aws_security_group" "alb" {
  name        = "{{ project }}_{{ env }}_alb"
  description = "ALB ingress for {{ project }} {{ env }}"
  vpc_id      = data.aws_vpc.project.id
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    project    = "{{ project }}"
    env        = "{{ env }}"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# Reverse proxy: one ALB per env
# ---------------------------------------------------------------------------
resource "aws_lb" "alb" {
  name               = "{{ project }}-{{ env }}-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = data.aws_subnets.public.ids
  tags = {
    project    = "{{ project }}"
    env        = "{{ env }}"
    managed_by = "doctrine"
  }
}

resource "aws_lb_listener" "alb_https" {
  load_balancer_arn = aws_lb.alb.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-2016-08"
  certificate_arn   = data.aws_acm_certificate.project.arn
  default_action {
    type = "fixed-response"
    fixed_response {
      content_type = "text/plain"
      status_code  = "404"
      message_body = "not found"
    }
  }
}

resource "aws_lb_listener" "alb_http_redirect" {
  load_balancer_arn = aws_lb.alb.arn
  port              = 80
  protocol          = "HTTP"
  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

# ---------------------------------------------------------------------------
# ECS cluster
# ---------------------------------------------------------------------------
resource "aws_ecs_cluster" "cluster" {
  name = "{{ project }}-{{ env }}"
  tags = {
    project    = "{{ project }}"
    env        = "{{ env }}"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# Backing services
# ---------------------------------------------------------------------------
{% for svc in backing_services -%}
{{ render_backing(svc) }}

{% endfor %}

# ---------------------------------------------------------------------------
# Core services (ECS task definitions, services, target groups)
# ---------------------------------------------------------------------------
{% for svc in core_services -%}
{{ render_core(svc) }}

{% endfor %}

# ---------------------------------------------------------------------------
# Route53 record: <env-subdomain> -> ALB
# ---------------------------------------------------------------------------
resource "aws_route53_record" "env" {
  zone_id = data.aws_route53_zone.project.zone_id
  name    = "{{ subdomain }}"
  type    = "A"
  alias {
    name                   = aws_lb.alb.dns_name
    zone_id                = aws_lb.alb.zone_id
    evaluate_target_health = false
  }
}

# Per-service subdomains (<service>.{{ subdomain }}) all resolve to the
# same ALB; the listener rules dispatch by host header. One wildcard record
# covers every web service in this env.
resource "aws_route53_record" "env_wildcard" {
  zone_id = data.aws_route53_zone.project.zone_id
  name    = "*.{{ subdomain }}"
  type    = "A"
  alias {
    name                   = aws_lb.alb.dns_name
    zone_id                = aws_lb.alb.zone_id
    evaluate_target_health = false
  }
}
