{# Mod 060: render the standard three-block tags (cicl.md § Naming and
   Tagging). `tags` is the ordered dict from the `standard_tags` global. -#}
{%- macro tagblock(tags) -%}
{{ "  tags = {" }}
{%- for k, v in tags.items() %}
    {{ k }} = "{{ v }}"
{%- endfor %}
  }
{%- endmacro -%}
{# Project-tier HCL. One copy per project, shared by all elastic envs. -#}
# Generated by `docex compile`. Do not edit by hand.
# project: {{ project }} v{{ project_version }}
# tier: project (foundation: elastic)
# apex_domain: {{ apex_domain }}
#
# The resources here back every elastic environment's main.tf via
# `data "terraform_remote_state" "project"`. They are applied by
# `docex bootstrap` against their own state file (project/terraform.tfstate)
# in the same S3 backend the bootstrap creates.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  backend "s3" {
    bucket         = "{{ state_bucket }}"
    key            = "project/terraform.tfstate"
    region         = "{{ region }}"
    dynamodb_table = "{{ state_lock_table }}"
    encrypt        = true
  }
}

provider "aws" {
  region = "{{ region }}"
}

# ---------------------------------------------------------------------------
# Route53 hosted zone for the project subdomain (`<project>.<apex_domain>`).
#
# The zone covers the project's subdomain — not the bare apex. The apex zone
# typically belongs to whoever owns the registrar account; this project's
# zone is delegated from there via NS records.
#
# The operator must NS-delegate `<project>.<apex_domain>` from the parent
# zone (`<apex_domain>`, at the registrar or parent Route53 hosted zone)
# using the name servers printed by `docex bootstrap` after the first apply.
# Until that delegation propagates, ACM DNS validation will not complete,
# which is why `docex bootstrap` applies this zone first and pauses for
# delegation before proceeding to the certs.
# ---------------------------------------------------------------------------
resource "aws_route53_zone" "project" {
  name = "{{ project_subdomain }}"
{{ tagblock(standard_tags("project", shape_name="dns", descriptor="zone", project=project)) }}
}

# ---------------------------------------------------------------------------
# Master VPC — preinfra. Operator brings it up out-of-band; docex consumes
# via tag-based data sources. See preinfra/elastic_master_network.md.
# ---------------------------------------------------------------------------
data "aws_vpc" "master" {
  # Mod 060: semantic tag filter (cicl.md § Naming and Tagging preinfra
  # block). Matches on the load-bearing identity tags, NOT the redundant
  # console-only `Name`. The master network is operator-managed preinfra,
  # so `managed_by=doctrine-operator`.
  tags = {
    managed_by = "doctrine-operator"
    infra_tier = "prerequisite"
    shape_name = "master_network"
  }
}

data "aws_subnets" "public" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.master.id]
  }
  tags = {
    tier = "public"
  }
}

data "aws_subnets" "private" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.master.id]
  }
  tags = {
    tier = "private"
  }
}

# Primary-AZ private subnet — single-AZ commit per cicl.md.
data "aws_subnet" "primary_private" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.master.id]
  }
  filter {
    name   = "availability-zone"
    values = ["us-east-1a"]
  }
  tags = {
    tier = "private"
  }
}

{% if reverse_proxy == "alb" %}
# ---------------------------------------------------------------------------
# ACM certificates — one per ALB-served env.
#
# Two certs ship per project per the doctrine's "stage and prod cert-separated
# for blast-radius" rule (cicl.md § TLS Implications):
#   - Stage cert covers `*.stage.<project>.<apex>` and `stage.<project>.<apex>`.
#   - Prod cert covers `*.prod.<project>.<apex>`, `prod.<project>.<apex>`, and
#     the bare-project ergonomic `<project>.<apex>`.
# Dev and test envs are always fixed-style; they never reach the ALB and are
# excluded from these certs.
#
# Mod 044: ACM is ALB-only. EC2-traefik uses traefik's built-in Let's Encrypt
# client (DNS-01 via Route53) instead — see projinfra/ec2_traefik.md.
# ---------------------------------------------------------------------------
resource "aws_acm_certificate" "stage" {
  domain_name = "*.stage.{{ project_subdomain }}"
  subject_alternative_names = [
    "stage.{{ project_subdomain }}",
  ]
  validation_method = "DNS"
  lifecycle {
    create_before_destroy = true
  }
{{ tagblock(standard_tags("project", shape_name="cert_manager", descriptor="stage-cert", project=project)) }}
}

resource "aws_acm_certificate" "prod" {
  domain_name = "*.prod.{{ project_subdomain }}"
  subject_alternative_names = [
    "prod.{{ project_subdomain }}",
    "{{ project_subdomain }}",
  ]
  validation_method = "DNS"
  lifecycle {
    create_before_destroy = true
  }
{{ tagblock(standard_tags("project", shape_name="cert_manager", descriptor="prod-cert", project=project)) }}
}

resource "aws_route53_record" "cert_validation_stage" {
  for_each = {
    for dvo in aws_acm_certificate.stage.domain_validation_options : dvo.domain_name => {
      name   = dvo.resource_record_name
      record = dvo.resource_record_value
      type   = dvo.resource_record_type
    }
  }
  allow_overwrite = true
  name            = each.value.name
  records         = [each.value.record]
  ttl             = 60
  type            = each.value.type
  zone_id         = aws_route53_zone.project.zone_id
}

resource "aws_route53_record" "cert_validation_prod" {
  for_each = {
    for dvo in aws_acm_certificate.prod.domain_validation_options : dvo.domain_name => {
      name   = dvo.resource_record_name
      record = dvo.resource_record_value
      type   = dvo.resource_record_type
    }
  }
  allow_overwrite = true
  name            = each.value.name
  records         = [each.value.record]
  ttl             = 60
  type            = each.value.type
  zone_id         = aws_route53_zone.project.zone_id
}

resource "aws_acm_certificate_validation" "stage" {
  certificate_arn         = aws_acm_certificate.stage.arn
  validation_record_fqdns = [for record in aws_route53_record.cert_validation_stage : record.fqdn]
}

resource "aws_acm_certificate_validation" "prod" {
  certificate_arn         = aws_acm_certificate.prod.arn
  validation_record_fqdns = [for record in aws_route53_record.cert_validation_prod : record.fqdn]
}

# ---------------------------------------------------------------------------
# Project-tier ALB. One per project, serves stage and prod via SNI
# listener-cert bindings + env-tier listener rules. See
# projinfra/elastic_alb.md.
# ---------------------------------------------------------------------------
resource "aws_security_group" "project_alb" {
  name        = "{{ alb_sg_name }}"
  description = "Project ALB ingress (80/443 from internet); egress all."
  vpc_id      = data.aws_vpc.master.id
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
{{ tagblock(standard_tags("project", shape_name="reverse_proxy", descriptor="ALB-SG", project=project)) }}
}

resource "aws_lb" "project" {
  name               = "{{ alb_name }}"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.project_alb.id]
  subnets            = data.aws_subnets.public.ids
{{ tagblock(standard_tags("project", shape_name="reverse_proxy", descriptor="ALB", project=project)) }}
}

resource "aws_lb_listener" "project_https" {
  load_balancer_arn = aws_lb.project.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-2016-08"
  # WHY: prod cert is the listener default; stage cert is attached as
  # an additional SNI binding below. SNI behavior selects whichever
  # cert's SAN matches the incoming Host header, and the default cert
  # is the conservative fallback for an unrecognised host.
  certificate_arn   = aws_acm_certificate_validation.prod.certificate_arn
  default_action {
    type = "fixed-response"
    fixed_response {
      content_type = "text/plain"
      status_code  = "404"
      message_body = "not found"
    }
  }
}

resource "aws_lb_listener_certificate" "project_stage" {
  listener_arn    = aws_lb_listener.project_https.arn
  certificate_arn = aws_acm_certificate_validation.stage.certificate_arn
}

resource "aws_lb_listener" "project_http" {
  load_balancer_arn = aws_lb.project.arn
  port              = 80
  protocol          = "HTTP"
  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}
{% elif reverse_proxy in ("ec2_traefik_eip", "ec2_traefik_pip") %}
# ---------------------------------------------------------------------------
# EC2-traefik reverse proxy — mod 044.
#
# A single t3.nano running Traefik replaces the project ALB for cost-sensitive
# projects. Traefik terminates TLS with built-in Let's Encrypt (DNS-01 via
# Route53) and discovers routes via its ECS provider: it polls the project's
# stage + prod clusters, reads each RUNNING task's ENI private IP directly, and
# builds routers/services from the tasks' traefik.* dockerLabels (mod 070).
#
# See doctrine/infrastructure/specifics/projinfra/ec2_traefik.md for the full
# resource spec, IAM scoping, and user_data behavior.
#
# Variant: {{ reverse_proxy }}
# ---------------------------------------------------------------------------

# Canonical Ubuntu 24.04 LTS. Owner `099720109477` is Canonical's AWS account.
# The name pattern pins to the 24.04 (Noble) gp3 amd64 server image.
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# Public subnet in the primary AZ (us-east-1a) — the traefik instance needs
# an inbound-reachable public IP and should sit in the same AZ as the ECS
# services it routes to (cross-AZ data transfer cost reasons).
data "aws_subnet" "primary_public" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.master.id]
  }
  filter {
    name   = "availability-zone"
    values = ["us-east-1a"]
  }
  tags = {
    tier = "public"
  }
}

resource "aws_security_group" "project_traefik" {
  name        = "{{ project | replace('_', '-') }}-traefik"
  description = "Project EC2-traefik ingress (80/443 from internet); egress all."
  vpc_id      = data.aws_vpc.master.id
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
{{ tagblock(standard_tags("project", shape_name="reverse_proxy", descriptor="SG", project=project)) }}
}

# IAM role + instance profile for the traefik EC2 instance. Distinct from the
# ECS task-execution role above — different principal (ec2 vs ecs-tasks) and
# different permissions (Route53 ChangeRecordSets, read-only ECS/EC2 discovery
# for the traefik ECS provider, EBS attach, CloudWatch log writes).
resource "aws_iam_role" "project_traefik" {
  name = "{{ project }}_traefik_role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
{{ tagblock(standard_tags("project", shape_name="reverse_proxy", descriptor="iam-role", project=project)) }}
}

resource "aws_iam_instance_profile" "project_traefik" {
  name = "{{ project }}_traefik_profile"
  role = aws_iam_role.project_traefik.name
}

resource "aws_iam_role_policy" "project_traefik" {
  name = "{{ project }}_traefik_policy"
  role = aws_iam_role.project_traefik.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        # Route53 record changes are scoped to the project's hosted zone only —
        # a compromised instance cannot manipulate DNS for sibling projects on
        # the same apex domain. Used for LE DNS-01 challenge + PIP boot DNS
        # update.
        Effect = "Allow"
        Action = [
          "route53:ChangeResourceRecordSets",
          "route53:GetChange",
        ]
        Resource = [
          "arn:aws:route53:::hostedzone/${aws_route53_zone.project.zone_id}",
          "arn:aws:route53:::change/*",
        ]
      },
      {
        # ListHostedZones{,ByName} / GetHostedZone are unscopeable per AWS
        # IAM — the traefik LE client needs them to discover the zone for
        # DNS-01. lego's route53 provider specifically calls
        # ListHostedZonesByName; its absence 403'd cert issuance even after
        # AWS_REGION was set (mod 071).
        Effect   = "Allow"
        Action   = [
          "route53:ListHostedZones",
          "route53:ListHostedZonesByName",
          "route53:GetHostedZone",
          "route53:ListResourceRecordSets",
        ]
        Resource = "*"
      },
      {
        # Cluster-scoped discovery for the traefik ECS provider.
        Effect   = "Allow"
        Action   = [
          "ecs:ListTasks",
          "ecs:DescribeTasks",
          "ecs:DescribeServices",
          "ecs:DescribeContainerInstances",
        ]
        Resource = "*"
        Condition = {
          ArnEquals = {
            "ecs:cluster" = [
{% for c in ecs_clusters.values() %}              "arn:aws:ecs:{{ region }}:${data.aws_caller_identity.current.account_id}:cluster/{{ c }}",
{% endfor %}            ]
          }
        }
      },
      {
        # Unscopeable read-only discovery calls (AWS permits no resource-
        # level scoping on these).
        Effect   = "Allow"
        Action   = [
          "ecs:ListClusters",
          "ecs:DescribeClusters",
          "ecs:DescribeTaskDefinition",
          "ec2:DescribeInstances",
        ]
        Resource = "*"
      },
      {
        Effect   = "Allow"
        Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
        Resource = "arn:aws:logs:{{ region }}:${data.aws_caller_identity.current.account_id}:log-group:/{{ ssm_path_project }}/ec2_traefik:*"
      },
      {
        # EBS attach is scoped by tag — only volumes tagged
        # `purpose=ec2_traefik_acme` AND project=<this project> may be
        # attached. DescribeVolumes is required to look up the volume by tag
        # but is unscopeable in IAM.
        Effect   = "Allow"
        Action   = "ec2:DescribeVolumes"
        Resource = "*"
      },
      {
        Effect = "Allow"
        Action = ["ec2:AttachVolume", "ec2:DetachVolume"]
        Resource = [
          "arn:aws:ec2:{{ region }}:${data.aws_caller_identity.current.account_id}:volume/*",
          "arn:aws:ec2:{{ region }}:${data.aws_caller_identity.current.account_id}:instance/*",
        ]
        Condition = {
          StringEquals = {
            "aws:ResourceTag/purpose" = "ec2_traefik_acme"
            "aws:ResourceTag/project" = "{{ project }}"
          }
        }
      },
    ]
  })
}

resource "aws_cloudwatch_log_group" "project_traefik" {
  name              = "/{{ ssm_path_project }}/ec2_traefik"
  retention_in_days = 30
{{ tagblock(standard_tags("project", shape_name="reverse_proxy", descriptor="logs", project=project)) }}
}

# EBS volume that holds traefik's acme.json (LE cert material + account key).
# Survives instance replacement so AMI / user_data bumps don't trigger LE
# reissuance and hit rate limits.
resource "aws_ebs_volume" "project_traefik_acme" {
  availability_zone = data.aws_subnet.primary_public.availability_zone
  size              = 8
  type              = "gp3"
  encrypted         = true
  # Mod 060: standard projinfra block PLUS the load-bearing
  # `purpose=ec2_traefik_acme` tag — the traefik IAM role's AttachVolume
  # grant is conditioned on it (with project), so it must persist.
  tags = {
{%- for k, v in standard_tags("project", shape_name="reverse_proxy", descriptor="acme-ebs", project=project).items() %}
    {{ k }} = "{{ v }}"
{%- endfor %}
    purpose = "ec2_traefik_acme"
  }
}

{% if reverse_proxy == "ec2_traefik_eip" %}
# EIP variant: stable public IP across instance stop/start. Costs 1 EIP from
# the regional quota.
resource "aws_eip" "project_traefik" {
  domain = "vpc"
{{ tagblock(standard_tags("project", shape_name="reverse_proxy", descriptor="EIP", project=project)) }}
}
{% endif %}

resource "aws_instance" "project_traefik" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = "t3.nano"
  subnet_id     = data.aws_subnet.primary_public.id
  vpc_security_group_ids      = [aws_security_group.project_traefik.id]
  iam_instance_profile        = aws_iam_instance_profile.project_traefik.name
  {% if reverse_proxy == "ec2_traefik_eip" -%}
  # EIP variant: EIP attaches separately via aws_eip_association below; the
  # auto-assigned public IP is suppressed so we don't double-allocate.
  associate_public_ip_address = false
  {%- else -%}
  # PIP variant: subnet's `map_public_ip_on_launch` setting determines the
  # default; explicitly request a public IP to remain independent of subnet
  # config.
  associate_public_ip_address = true
  {%- endif %}
  user_data = <<-USER_DATA
{{ traefik_user_data }}
  USER_DATA
  user_data_replace_on_change = true
{# Mod 060: the old hand-set `Name = <proj>-traefik` is superseded by the
   standard block's Name (`<project>_reverse_proxy_EC2`). The instance is
   referenced by resource ref, never by that Name.
   Mod 066: PLUS the load-bearing `purpose=ec2_traefik_acme` tag. The traefik
   IAM role's ec2:AttachVolume grant is conditioned on purpose+project for
   BOTH the volume AND the instance resource (project.tf.j2 § IAM); without
   this tag on the instance, AttachVolume is AccessDenied and user_data aborts
   before traefik starts. Mirrors the acme volume's tag pattern above. -#}
  tags = {
{%- for k, v in standard_tags("project", shape_name="reverse_proxy", descriptor="EC2", project=project).items() %}
    {{ k }} = "{{ v }}"
{%- endfor %}
    purpose = "ec2_traefik_acme"
  }
}

{% if reverse_proxy == "ec2_traefik_eip" %}
resource "aws_eip_association" "project_traefik" {
  instance_id   = aws_instance.project_traefik.id
  allocation_id = aws_eip.project_traefik.id
}
{% endif %}

# Five Route53 A-records — the same five hosts the ALB path would otherwise
# point at via env-tier alias records. With EC2-traefik these live at the
# project tier because they all converge on a single instance regardless of
# env. TTL = 60s so PIP-variant IP changes propagate quickly; the same TTL
# applies to EIP for consistency.
{% set traefik_target = "aws_eip.project_traefik.public_ip" if reverse_proxy == "ec2_traefik_eip" else "aws_instance.project_traefik.public_ip" %}
{% set traefik_records = [
  ("bare_project",   project_subdomain),
  ("prod_wildcard",  "*.prod." ~ project_subdomain),
  ("prod_bare",      "prod." ~ project_subdomain),
  ("stage_wildcard", "*.stage." ~ project_subdomain),
  ("stage_bare",     "stage." ~ project_subdomain),
] %}
{% for key, fqdn in traefik_records %}
resource "aws_route53_record" "traefik_{{ key }}" {
  zone_id = aws_route53_zone.project.zone_id
  name    = "{{ fqdn }}"
  type    = "A"
  ttl     = 60
  records = [{{ traefik_target }}]
}
{% endfor %}
{% endif %}

# ---------------------------------------------------------------------------
# ECS clusters — one per elastic env (stage + prod), project-tier (mod 071).
#
# Both clusters always exist for every elastic project, on both reverse-proxy
# paths. WHY project-tier: the EC2-traefik ECS provider lists BOTH clusters
# statically; it treats a ListTasks error on any listed cluster as fatal for
# the entire refresh, so a stage-only release with the prod cluster absent
# would build zero routes. Empty ECS clusters are free. Each env's main.tf
# references its cluster ARN via terraform_remote_state (never creates one).
# ---------------------------------------------------------------------------
resource "aws_ecs_cluster" "stage" {
  name = "{{ ecs_clusters.stage }}"
{{ tagblock(standard_tags("project", shape_name="ecs_cluster", descriptor="stage", project=project)) }}
}

resource "aws_ecs_cluster" "prod" {
  name = "{{ ecs_clusters.prod }}"
{{ tagblock(standard_tags("project", shape_name="ecs_cluster", descriptor="prod", project=project)) }}
}

# ---------------------------------------------------------------------------
# ECR repositories — one per core service. The image refs in each env's
# main.tf resolve to `<repo_url>:<version>`.
# ---------------------------------------------------------------------------
{% for svc in core_service_names %}
resource "aws_ecr_repository" "{{ svc.hcl_id }}" {
  name                 = "{{ ecr_repo_names[svc.name] }}"
  image_tag_mutability = "MUTABLE"
{# Mod 060: per-service differentiation rides in descriptor (the service
   name) + Name; the projinfra block has no `service` tag. -#}
{{ tagblock(standard_tags("project", shape_name="container_registry", descriptor=svc.name, project=project)) }}
}
{% endfor %}

# ---------------------------------------------------------------------------
# ECS task execution role.
#
# Fargate assumes this role *during launch* to pull images from ECR,
# fetch SSM parameters referenced in container `secrets[]` blocks, and
# write to CloudWatch Logs. Distinct from any "task role" the app
# itself might use to call AWS APIs at runtime — task role is per-app
# and out of scope for the doctrine skeleton.
#
# Provisioned at the project tier (not per-env) because the role's
# permissions are derived from project identity (the SSM prefix), not
# env identity. Each env's ECS task definitions reference the role ARN
# via terraform_remote_state.
# ---------------------------------------------------------------------------
data "aws_caller_identity" "current" {}

resource "aws_iam_role" "task_execution" {
  name = "{{ task_execution_role_name }}"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
{{ tagblock(standard_tags("project", shape_name="etc", descriptor="exec-role", project=project)) }}
}

# Inline policy scoped to project resources only. Replaces the
# AWS-managed AmazonECSTaskExecutionRolePolicy with explicit grants so
# cross-project isolation is enforced at the IAM layer
# (projinfra/elastic_iam.md). KMS Decrypt is intentionally absent —
# AWS-managed `aws/ssm` key decryption requires no explicit grant.
resource "aws_iam_role_policy" "task_execution" {
  name = "{{ task_execution_policy_name }}"
  role = aws_iam_role.task_execution.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = "ecr:GetAuthorizationToken"
        Resource = "*"
      },
      {%- if core_service_names %}
      {
        Effect = "Allow"
        Action = [
          "ecr:BatchCheckLayerAvailability",
          "ecr:BatchGetImage",
          "ecr:GetDownloadUrlForLayer",
        ]
        Resource = [
          {%- for svc in core_service_names %}
          aws_ecr_repository.{{ svc.hcl_id }}.arn,
          {%- endfor %}
        ]
      },
      {%- endif %}
      {
        Effect   = "Allow"
        Action   = "ssm:GetParameters"
        Resource = "arn:aws:ssm:{{ region }}:${data.aws_caller_identity.current.account_id}:parameter/{{ ssm_path_project }}/stage/*"
      },
      {
        Effect   = "Allow"
        Action   = "ssm:GetParameters"
        Resource = "arn:aws:ssm:{{ region }}:${data.aws_caller_identity.current.account_id}:parameter/{{ ssm_path_project }}/prod/*"
      },
      {
        Effect = "Allow"
        Action = [
          "logs:CreateLogStream",
          "logs:PutLogEvents",
        ]
        Resource = [
          "arn:aws:logs:{{ region }}:${data.aws_caller_identity.current.account_id}:log-group:/{{ ssm_path_project }}/stage/*",
          "arn:aws:logs:{{ region }}:${data.aws_caller_identity.current.account_id}:log-group:/{{ ssm_path_project }}/prod/*",
        ]
      },
    ]
  })
}

# ---------------------------------------------------------------------------
# Outputs. Consumed by each env's main.tf via terraform_remote_state.
# ---------------------------------------------------------------------------
output "vpc_id" {
  value = data.aws_vpc.master.id
}

output "public_subnet_ids" {
  value = data.aws_subnets.public.ids
}

output "private_subnet_ids" {
  value = data.aws_subnets.private.ids
}

# Mod 041: primary-AZ private subnet for single-AZ ECS placement.
output "primary_private_subnet_id" {
  value = data.aws_subnet.primary_private.id
}

output "zone_id" {
  value = aws_route53_zone.project.zone_id
}

output "zone_name_servers" {
  value = aws_route53_zone.project.name_servers
}

output "task_execution_role_arn" {
  value = aws_iam_role.task_execution.arn
}

# Mod 071: project-tier ECS cluster ARNs, one per elastic env. Each env's
# main.tf references its own via `ecs_cluster_<env>_arn`.
output "ecs_cluster_stage_arn" {
  value = aws_ecs_cluster.stage.arn
}

output "ecs_cluster_prod_arn" {
  value = aws_ecs_cluster.prod.arn
}

# Mod 044: polymorphic output. Env-tier `web` SGs use it as their ingress
# source SG, regardless of which reverse-proxy variant the project picked.
output "reverse_proxy_security_group_id" {
  value = {% if reverse_proxy == "alb" -%}
  aws_security_group.project_alb.id
  {%- else -%}
  aws_security_group.project_traefik.id
  {%- endif %}
}

{% if reverse_proxy == "alb" %}
# ALB-only outputs. Gated on `reverse_proxy == "alb"` (mod 044) — projects
# using EC2-traefik don't have an ALB and these outputs would dangle.
output "stage_cert_arn" {
  value = aws_acm_certificate_validation.stage.certificate_arn
}

output "prod_cert_arn" {
  value = aws_acm_certificate_validation.prod.certificate_arn
}

output "alb_arn" {
  value = aws_lb.project.arn
}

output "alb_dns_name" {
  value = aws_lb.project.dns_name
}

output "alb_zone_id" {
  value = aws_lb.project.zone_id
}

output "alb_https_listener_arn" {
  value = aws_lb_listener.project_https.arn
}

output "alb_http_listener_arn" {
  value = aws_lb_listener.project_http.arn
}

output "alb_security_group_id" {
  value = aws_security_group.project_alb.id
}
{% endif %}
{% for svc in core_service_names %}
output "ecr_repository_{{ svc.hcl_id }}_url" {
  value = aws_ecr_repository.{{ svc.hcl_id }}.repository_url
}
{% endfor %}
