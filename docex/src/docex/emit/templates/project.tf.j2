{# Project-tier HCL. One copy per project, shared by all elastic envs. -#}
# Generated by `docex compile`. Do not edit by hand.
# project: {{ project }} v{{ project_version }}
# tier: project (foundation: elastic)
# domain: {{ domain }}
#
# The resources here back every elastic environment's main.tf via
# `data "terraform_remote_state" "project"`. They are applied by
# `docex bootstrap` against their own state file (project/terraform.tfstate)
# in the same S3 backend the bootstrap creates.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  backend "s3" {
    bucket         = "{{ project }}-tofu-state"
    key            = "project/terraform.tfstate"
    region         = "{{ region }}"
    dynamodb_table = "{{ project }}-tofu-locks"
    encrypt        = true
  }
}

provider "aws" {
  region = "{{ region }}"
}

data "aws_availability_zones" "available" {
  state = "available"
}

# ---------------------------------------------------------------------------
# Route53 hosted zone for the project domain.
#
# The operator must NS-delegate from the parent (registrar or parent hosted
# zone) using the name servers printed by `docex bootstrap` after the first
# apply. Until that delegation propagates, ACM DNS validation will not
# complete, which is why `docex bootstrap` applies this zone first and pauses
# for delegation before proceeding to the cert.
# ---------------------------------------------------------------------------
resource "aws_route53_zone" "project" {
  name = "{{ domain }}"
  tags = {
    project    = "{{ project }}"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# VPC + IGW + public/private subnets across two AZs + NAT gateways.
# ---------------------------------------------------------------------------
resource "aws_vpc" "project" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = {
    project    = "{{ project }}"
    managed_by = "doctrine"
    Name       = "{{ project }}"
  }
}

resource "aws_internet_gateway" "project" {
  vpc_id = aws_vpc.project.id
  tags = {
    project    = "{{ project }}"
    managed_by = "doctrine"
  }
}

resource "aws_subnet" "public" {
  count                   = 2
  vpc_id                  = aws_vpc.project.id
  cidr_block              = cidrsubnet(aws_vpc.project.cidr_block, 8, count.index)
  availability_zone       = data.aws_availability_zones.available.names[count.index]
  map_public_ip_on_launch = true
  tags = {
    project    = "{{ project }}"
    tier       = "public"
    managed_by = "doctrine"
    Name       = "{{ project }}_public_${data.aws_availability_zones.available.names[count.index]}"
  }
}

resource "aws_subnet" "private" {
  count             = 2
  vpc_id            = aws_vpc.project.id
  cidr_block        = cidrsubnet(aws_vpc.project.cidr_block, 8, 10 + count.index)
  availability_zone = data.aws_availability_zones.available.names[count.index]
  tags = {
    project    = "{{ project }}"
    tier       = "private"
    managed_by = "doctrine"
    Name       = "{{ project }}_private_${data.aws_availability_zones.available.names[count.index]}"
  }
}

resource "aws_eip" "nat" {
  count  = 2
  domain = "vpc"
  tags = {
    project    = "{{ project }}"
    managed_by = "doctrine"
  }
}

resource "aws_nat_gateway" "project" {
  count         = 2
  allocation_id = aws_eip.nat[count.index].id
  subnet_id     = aws_subnet.public[count.index].id
  tags = {
    project    = "{{ project }}"
    managed_by = "doctrine"
  }
  depends_on = [aws_internet_gateway.project]
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.project.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.project.id
  }
  tags = {
    project    = "{{ project }}"
    tier       = "public"
    managed_by = "doctrine"
  }
}

resource "aws_route_table_association" "public" {
  count          = 2
  subnet_id      = aws_subnet.public[count.index].id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table" "private" {
  count  = 2
  vpc_id = aws_vpc.project.id
  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.project[count.index].id
  }
  tags = {
    project    = "{{ project }}"
    tier       = "private"
    managed_by = "doctrine"
  }
}

resource "aws_route_table_association" "private" {
  count          = 2
  subnet_id      = aws_subnet.private[count.index].id
  route_table_id = aws_route_table.private[count.index].id
}

# ---------------------------------------------------------------------------
# ACM certificate.
#
# `*.{{ domain }}` covers the env subdomains (`dev.{{ domain }}`,
# `test.{{ domain }}`, `stage.{{ domain }}`, `www.{{ domain }}`). The four
# per-env wildcard SANs cover per-service hosts
# (e.g. `backend.stage.{{ domain }}`).
# ---------------------------------------------------------------------------
resource "aws_acm_certificate" "project" {
  domain_name = "*.{{ domain }}"
  subject_alternative_names = [
    "*.dev.{{ domain }}",
    "*.test.{{ domain }}",
    "*.stage.{{ domain }}",
    "*.www.{{ domain }}",
  ]
  validation_method = "DNS"
  lifecycle {
    create_before_destroy = true
  }
  tags = {
    project    = "{{ project }}"
    managed_by = "doctrine"
  }
}

resource "aws_route53_record" "cert_validation" {
  for_each = {
    for dvo in aws_acm_certificate.project.domain_validation_options : dvo.domain_name => {
      name   = dvo.resource_record_name
      record = dvo.resource_record_value
      type   = dvo.resource_record_type
    }
  }
  allow_overwrite = true
  name            = each.value.name
  records         = [each.value.record]
  ttl             = 60
  type            = each.value.type
  zone_id         = aws_route53_zone.project.zone_id
}

resource "aws_acm_certificate_validation" "project" {
  certificate_arn         = aws_acm_certificate.project.arn
  validation_record_fqdns = [for record in aws_route53_record.cert_validation : record.fqdn]
}

# ---------------------------------------------------------------------------
# ECR repositories — one per core service. The image refs in each env's
# main.tf resolve to `<repo_url>:<version>`.
# ---------------------------------------------------------------------------
{% for svc in core_service_names %}
resource "aws_ecr_repository" "{{ svc.hcl_id }}" {
  name                 = "{{ project }}/{{ svc.name }}"
  image_tag_mutability = "MUTABLE"
  tags = {
    project    = "{{ project }}"
    service    = "{{ svc.name }}"
    managed_by = "doctrine"
  }
}
{% endfor %}

# ---------------------------------------------------------------------------
# Outputs. Consumed by each env's main.tf via terraform_remote_state.
# ---------------------------------------------------------------------------
output "vpc_id" {
  value = aws_vpc.project.id
}

output "public_subnet_ids" {
  value = aws_subnet.public[*].id
}

output "private_subnet_ids" {
  value = aws_subnet.private[*].id
}

output "zone_id" {
  value = aws_route53_zone.project.zone_id
}

output "zone_name_servers" {
  value = aws_route53_zone.project.name_servers
}

output "certificate_arn" {
  value = aws_acm_certificate_validation.project.certificate_arn
}
{% for svc in core_service_names %}
output "ecr_repository_{{ svc.hcl_id }}_url" {
  value = aws_ecr_repository.{{ svc.hcl_id }}.repository_url
}
{% endfor %}
