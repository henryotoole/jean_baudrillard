# Build artifacts (dev-iteration only; prod artifacts live inside images)
core/*/dist/

# OpenTofu local state and plan files
# (state itself is remote per elastic_bootstrap, but the directory and lock files are local)
infra/output/**/.terraform/
infra/output/**/.terraform.lock.hcl
infra/output/**/*.tfplan
infra/output/**/*.tfstate*

# Secrets — ignore env files; allow the example template
infra/secrets/*
!infra/secrets/.gitignore
!infra/secrets/README.md
!infra/secrets/example.env

# Deploy credentials — ignore private keys; allow public keys
infra/deploy_creds/*
!infra/deploy_creds/.gitignore
!infra/deploy_creds/README.md
!infra/deploy_creds/*.pub

# Docex ephemeral worktrees
.docex/

# Python bytecode caches
__pycache__/
*.pyc

# OS noise
.DS_Store
Thumbs.db
