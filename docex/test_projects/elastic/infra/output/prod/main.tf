# Generated by `docex compile`. Do not edit by hand.
# project: docex_smoke_elastic v0.0.8
# env: prod (foundation: elastic)
# domain: doctrine-elastic.luxrnd.tech -> www.doctrine-elastic.luxrnd.tech

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  # State backend reference (provisioned by `docex bootstrap`).
  backend "s3" {
    bucket         = "docex-smoke-elastic-tofu-state"
    key            = "prod/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "docex_smoke_elastic_tofu_locks"
    encrypt        = true
  }
}

provider "aws" {
  region = "us-east-1"
}

# AWS account ID — used downstream for SSM parameter ARNs in ECS
# secrets[] blocks. Resolved at apply time so `docex compile` stays
# offline-pure (no AWS creds required for compile).
data "aws_caller_identity" "current" {}

# ---------------------------------------------------------------------------
# Project-tier outputs (VPC, subnets, Route53 zone, ACM cert, ECR repos).
# Provisioned once by `docex bootstrap` against ../project/main.tf; the
# env-tier apply just composes them.
# ---------------------------------------------------------------------------
data "terraform_remote_state" "project" {
  backend = "s3"
  config = {
    bucket = "docex-smoke-elastic-tofu-state"
    key    = "project/terraform.tfstate"
    region = "us-east-1"
  }
}

# ---------------------------------------------------------------------------
# Network plane (security groups; one per CICL-declared network)
# ---------------------------------------------------------------------------
resource "aws_security_group" "internal" {
  name        = "docex_smoke_elastic_prod_internal"
  description = "internal network for docex_smoke_elastic prod"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
  # WHY: aws_security_group denies egress when no egress block is given,
  # overriding AWS's allow-all default. Without this, Fargate tasks can't
  # reach SSM/ECR. Per-network egress restriction is deferred — see
  # infrastructure.md § Deferred rule 6.
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    project    = "docex_smoke_elastic"
    env        = "prod"
    network    = "internal"
    managed_by = "doctrine"
  }
}

# Internal SG: accepts ingress only from itself (services in the same network).
resource "aws_security_group_rule" "internal_self_ingress" {
  type              = "ingress"
  from_port         = 0
  to_port           = 65535
  protocol          = "tcp"
  security_group_id = aws_security_group.internal.id
  self              = true
}

resource "aws_security_group" "web" {
  name        = "docex_smoke_elastic_prod_web"
  description = "web network for docex_smoke_elastic prod"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
  # WHY: aws_security_group denies egress when no egress block is given,
  # overriding AWS's allow-all default. Without this, Fargate tasks can't
  # reach SSM/ECR. Per-network egress restriction is deferred — see
  # infrastructure.md § Deferred rule 6.
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    project    = "docex_smoke_elastic"
    env        = "prod"
    network    = "web"
    managed_by = "doctrine"
  }
}

# Web SG: open ingress only from the ALB SG.
resource "aws_security_group_rule" "web_ingress_from_alb" {
  type                     = "ingress"
  from_port                = 0
  to_port                  = 65535
  protocol                 = "tcp"
  security_group_id        = aws_security_group.web.id
  source_security_group_id = aws_security_group.alb.id
}



# ALB security group (allows public 443/80).
resource "aws_security_group" "alb" {
  name        = "docex_smoke_elastic_prod_alb"
  description = "ALB ingress for docex_smoke_elastic prod"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    project    = "docex_smoke_elastic"
    env        = "prod"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# Reverse proxy: one ALB per env
# ---------------------------------------------------------------------------
resource "aws_lb" "alb" {
  name               = "docex-smoke-elastic-prod-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = data.terraform_remote_state.project.outputs.public_subnet_ids
  tags = {
    project    = "docex_smoke_elastic"
    env        = "prod"
    managed_by = "doctrine"
  }
}

resource "aws_lb_listener" "alb_https" {
  load_balancer_arn = aws_lb.alb.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-2016-08"
  certificate_arn   = data.terraform_remote_state.project.outputs.certificate_arn
  default_action {
    type = "fixed-response"
    fixed_response {
      content_type = "text/plain"
      status_code  = "404"
      message_body = "not found"
    }
  }
}

resource "aws_lb_listener" "alb_http_redirect" {
  load_balancer_arn = aws_lb.alb.arn
  port              = 80
  protocol          = "HTTP"
  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

# ---------------------------------------------------------------------------
# ECS cluster
# ---------------------------------------------------------------------------
resource "aws_ecs_cluster" "cluster" {
  name = "docex_smoke_elastic_prod"
  tags = {
    project    = "docex_smoke_elastic"
    env        = "prod"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# Service discovery — ECS Service Connect over a Cloud Map HTTP namespace.
# Per shape2.md § Elastic-Foundation, one namespace per env. Services
# register themselves via service_connect_configuration on aws_ecs_service.
# ---------------------------------------------------------------------------
resource "aws_service_discovery_http_namespace" "env" {
  name        = "docex_smoke_elastic_prod"
  description = "ECS Service Connect namespace for docex_smoke_elastic prod"
  tags = {
    project    = "docex_smoke_elastic"
    env        = "prod"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# Services (backing first, then core; dispatch is by engine.emits.elastic).
# Per Mod 013, both backing and core services flow through the same
# destination-driven renderer — what HCL gets emitted is governed by the
# engine's declared emit destinations.
# ---------------------------------------------------------------------------
data "aws_ssm_parameter" "appdb_postgres_user" {
  name            = "/docex_smoke_elastic/prod/POSTGRES_USER"
  with_decryption = true
}
data "aws_ssm_parameter" "appdb_postgres_password" {
  name            = "/docex_smoke_elastic/prod/POSTGRES_PASSWORD"
  with_decryption = true
}

resource "aws_db_instance" "appdb" {
  allocated_storage = 20
  backup_retention_period = 7
  db_name = "appdb"
  db_subnet_group_name = aws_db_subnet_group.appdb.name
  deletion_protection = true
  engine = "postgres"
  engine_version = "15"
  identifier = "docex-smoke-elastic-prod-appdb"
  instance_class = "db.t3.medium"
  password = data.aws_ssm_parameter.appdb_postgres_password.value
  publicly_accessible = false
  storage_encrypted = false
  storage_type = "gp3"
  tags = {
    env = "prod"
    managed_by = "doctrine"
    project = "docex_smoke_elastic"
    role = "relational_db"
    service = "appdb"
  }
  username = data.aws_ssm_parameter.appdb_postgres_user.value
  vpc_security_group_ids = [aws_security_group.internal.id]
}

resource "aws_db_subnet_group" "appdb" {
  name       = "docex-smoke-elastic-prod-appdb"
  subnet_ids = data.terraform_remote_state.project.outputs.private_subnet_ids
}


resource "aws_ecs_task_definition" "events" {
  family                   = "docex_smoke_elastic_prod_events"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "1024"
  memory                   = "4096"
  execution_role_arn       = data.terraform_remote_state.project.outputs.task_execution_role_arn
  volume {
    name = "data"
    efs_volume_configuration {
      file_system_id     = aws_efs_file_system.events.id
      transit_encryption = "ENABLED"
    }
  }
  container_definitions = jsonencode([
    {
      essential = true
      image = "clickhouse/clickhouse-server:24.10"
      mountPoints = [{
          containerPath = "/var/lib/clickhouse"
          readOnly = false
          sourceVolume = "data"
        }]
      name = "events"
      portMappings = [{
          containerPort = 9000
          name = "events"
          protocol = "tcp"
        }]
