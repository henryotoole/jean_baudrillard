      image = "otel/opentelemetry-collector:0.153.0@sha256:74edb825a429b415262e7eb7a99ed77685c9b2b7238ef69fb42a3625df75458f"
      memory = 128
      name = "worker_otelcol"
      secrets = [{
          name = "TELEMETRY_API_KEY"
          valueFrom = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/docex_smoke_elastic/prod/TELEMETRY_API_KEY"
        }]
    },
  ])
  tags = { project = "docex_smoke_elastic", env = "prod", service = "worker", role = "web", managed_by = "doctrine" }
}

resource "aws_ecs_service" "worker" {
  name            = "docex_smoke_elastic_prod_worker"
  cluster         = aws_ecs_cluster.cluster.id
  task_definition = aws_ecs_task_definition.worker.arn
  launch_type     = "FARGATE"
  desired_count   = 1
  network_configuration {
    subnets         = data.terraform_remote_state.project.outputs.private_subnet_ids
    security_groups = [aws_security_group.internal.id]
  }
  service_connect_configuration {
    enabled   = true
    namespace = aws_service_discovery_http_namespace.env.arn
  }
}




# ---------------------------------------------------------------------------
# Route53 record: <env-subdomain> -> ALB
# ---------------------------------------------------------------------------
resource "aws_route53_record" "env" {
  zone_id = data.terraform_remote_state.project.outputs.zone_id
  name    = "www.doctrine-elastic.luxrnd.tech"
  type    = "A"
  alias {
    name                   = aws_lb.alb.dns_name
    zone_id                = aws_lb.alb.zone_id
    evaluate_target_health = false
  }
}

# Per-service subdomains (<service>.www.doctrine-elastic.luxrnd.tech) all resolve to the
# same ALB; the listener rules dispatch by host header. One wildcard record
# covers every web service in this env.
resource "aws_route53_record" "env_wildcard" {
  zone_id = data.terraform_remote_state.project.outputs.zone_id
  name    = "*.www.doctrine-elastic.luxrnd.tech"
  type    = "A"
  alias {
    name                   = aws_lb.alb.dns_name
    zone_id                = aws_lb.alb.zone_id
    evaluate_target_health = false
  }
}
