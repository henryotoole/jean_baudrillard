  desired_count   = 1
  network_configuration {
    subnets         = data.terraform_remote_state.project.outputs.private_subnet_ids
    security_groups = [aws_security_group.internal.id]
  }
  service_connect_configuration {
    enabled   = true
    namespace = aws_service_discovery_http_namespace.env.arn
    service {
      port_name      = "events"
      discovery_name = "docex_smoke_elastic_prod_events"
      client_alias {
        port     = 9000
        dns_name = "docex_smoke_elastic_prod_events"
      }
    }
  }
}

resource "aws_efs_file_system" "events" {
  creation_token   = "docex_smoke_elastic_prod_events"
  encrypted        = true
  performance_mode = "generalPurpose"
  throughput_mode  = "bursting"
  tags = { project = "docex_smoke_elastic", env = "prod", service = "events", role = "analytics_db", managed_by = "doctrine" }
}

resource "aws_efs_backup_policy" "events" {
  file_system_id = aws_efs_file_system.events.id
  backup_policy {
    status = "ENABLED"
  }
}

resource "aws_efs_mount_target" "events" {
  count           = length(data.terraform_remote_state.project.outputs.private_subnet_ids)
  file_system_id  = aws_efs_file_system.events.id
  subnet_id       = data.terraform_remote_state.project.outputs.private_subnet_ids[count.index]
  security_groups = [aws_security_group.internal.id]
}


