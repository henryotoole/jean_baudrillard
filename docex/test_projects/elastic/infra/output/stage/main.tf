# Generated by `docex compile`. Do not edit by hand.
# project: docex_smoke_elastic v0.0.1
# env: stage (foundation: elastic)
# domain: doctrine-elastic.luxrnd.tech -> stage.doctrine-elastic.luxrnd.tech

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  # State backend reference (provisioned by `docex bootstrap`).
  backend "s3" {
    bucket         = "docex-smoke-elastic-tofu-state"
    key            = "stage/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "docex_smoke_elastic_tofu_locks"
    encrypt        = true
  }
}

provider "aws" {
  region = "us-east-1"
}

# AWS account ID — used downstream for SSM parameter ARNs in ECS
# secrets[] blocks. Resolved at apply time so `docex compile` stays
# offline-pure (no AWS creds required for compile).
data "aws_caller_identity" "current" {}

# ---------------------------------------------------------------------------
# Project-tier outputs (VPC, subnets, Route53 zone, ACM cert, ECR repos).
# Provisioned once by `docex bootstrap` against ../project/main.tf; the
# env-tier apply just composes them.
# ---------------------------------------------------------------------------
data "terraform_remote_state" "project" {
  backend = "s3"
  config = {
    bucket = "docex-smoke-elastic-tofu-state"
    key    = "project/terraform.tfstate"
    region = "us-east-1"
  }
}

# ---------------------------------------------------------------------------
# Network plane (security groups; one per CICL-declared network)
# ---------------------------------------------------------------------------
resource "aws_security_group" "internal" {
  name        = "docex_smoke_elastic_stage_internal"
  description = "internal network for docex_smoke_elastic stage"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
  tags = {
    project    = "docex_smoke_elastic"
    env        = "stage"
    network    = "internal"
    managed_by = "doctrine"
  }
}

# Internal SG: accepts ingress only from itself (services in the same network).
resource "aws_security_group_rule" "internal_self_ingress" {
  type              = "ingress"
  from_port         = 0
  to_port           = 65535
  protocol          = "tcp"
  security_group_id = aws_security_group.internal.id
  self              = true
}

resource "aws_security_group" "web" {
  name        = "docex_smoke_elastic_stage_web"
  description = "web network for docex_smoke_elastic stage"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
  tags = {
    project    = "docex_smoke_elastic"
    env        = "stage"
    network    = "web"
    managed_by = "doctrine"
  }
}

# Web SG: open ingress only from the ALB SG.
resource "aws_security_group_rule" "web_ingress_from_alb" {
  type                     = "ingress"
  from_port                = 0
  to_port                  = 65535
  protocol                 = "tcp"
  security_group_id        = aws_security_group.web.id
  source_security_group_id = aws_security_group.alb.id
}



# ALB security group (allows public 443/80).
resource "aws_security_group" "alb" {
  name        = "docex_smoke_elastic_stage_alb"
  description = "ALB ingress for docex_smoke_elastic stage"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    project    = "docex_smoke_elastic"
    env        = "stage"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# Reverse proxy: one ALB per env
# ---------------------------------------------------------------------------
resource "aws_lb" "alb" {
  name               = "docex-smoke-elastic-stage-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = data.terraform_remote_state.project.outputs.public_subnet_ids
  tags = {
    project    = "docex_smoke_elastic"
    env        = "stage"
    managed_by = "doctrine"
  }
}

resource "aws_lb_listener" "alb_https" {
  load_balancer_arn = aws_lb.alb.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-2016-08"
  certificate_arn   = data.terraform_remote_state.project.outputs.certificate_arn
  default_action {
    type = "fixed-response"
    fixed_response {
      content_type = "text/plain"
      status_code  = "404"
      message_body = "not found"
    }
  }
}

resource "aws_lb_listener" "alb_http_redirect" {
  load_balancer_arn = aws_lb.alb.arn
  port              = 80
  protocol          = "HTTP"
  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

# ---------------------------------------------------------------------------
# ECS cluster
# ---------------------------------------------------------------------------
resource "aws_ecs_cluster" "cluster" {
  name = "docex_smoke_elastic_stage"
  tags = {
    project    = "docex_smoke_elastic"
    env        = "stage"
    managed_by = "doctrine"
  }
}

# ---------------------------------------------------------------------------
# Backing services
# ---------------------------------------------------------------------------
data "aws_ssm_parameter" "appdb_postgres_user" {
  name            = "/docex_smoke_elastic/stage/POSTGRES_USER"
  with_decryption = true
}
data "aws_ssm_parameter" "appdb_postgres_password" {
  name            = "/docex_smoke_elastic/stage/POSTGRES_PASSWORD"
  with_decryption = true
}

resource "aws_db_instance" "appdb" {
  allocated_storage = 20
  backup_retention_period = 7
  db_name = "appdb"
  db_subnet_group_name = aws_db_subnet_group.appdb.name
  deletion_protection = true
  engine = "postgres"
  engine_version = "15"
  identifier = "docex-smoke-elastic-stage-appdb"
  instance_class = "db.t3.medium"
  password = data.aws_ssm_parameter.appdb_postgres_password.value
  publicly_accessible = false
  storage_encrypted = false
  storage_type = "gp3"
  tags = {
    env = "stage"
    managed_by = "doctrine"
    project = "docex_smoke_elastic"
    role = "relational_db"
    service = "appdb"
  }
  username = data.aws_ssm_parameter.appdb_postgres_user.value
  vpc_security_group_ids = [aws_security_group.internal.id]
}

resource "aws_db_subnet_group" "appdb" {
  name       = "docex-smoke-elastic-stage-appdb"
  subnet_ids = data.terraform_remote_state.project.outputs.private_subnet_ids
}



# ---------------------------------------------------------------------------
# Core services (ECS task definitions, services, target groups)
# ---------------------------------------------------------------------------
resource "aws_ecs_task_definition" "web" {
  family                   = "docex_smoke_elastic_stage_web"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "256"
  memory                   = "512"
  execution_role_arn       = data.terraform_remote_state.project.outputs.task_execution_role_arn
  ephemeral_storage {
    size_in_gib = 24
  }
  container_definitions = jsonencode([
    {
      environment = [{
          name = "DATABASE_HOST"
          value = "${aws_db_instance.appdb.endpoint}"
        }, {
          name = "DATABASE_NAME"
          value = "appdb"
        }, {
          name = "DATABASE_PORT"
          value = "5432"
        }]
      essential = true
      image = "${data.terraform_remote_state.project.outputs.ecr_repository_web_url}:0.0.1"
      name = "web"
      portMappings = [{
          containerPort = 8080
          protocol = "tcp"
        }]
      secrets = [{
          name = "DATABASE_PASSWORD"
          valueFrom = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/docex_smoke_elastic/stage/POSTGRES_PASSWORD"
        }, {
          name = "DATABASE_USER"
          valueFrom = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/docex_smoke_elastic/stage/POSTGRES_USER"
        }]
    },
  ])
  tags = { project = "docex_smoke_elastic", env = "stage", service = "web", role = "web", managed_by = "doctrine" }
}

resource "aws_ecs_task_definition" "web_migrate" {
  family                   = "docex_smoke_elastic_stage_web_migrate"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "256"
  memory                   = "512"
  execution_role_arn       = data.terraform_remote_state.project.outputs.task_execution_role_arn
  container_definitions = jsonencode([
    {
      command = ["/service/migrate.sh"]
      environment = [{
          name = "DATABASE_HOST"
          value = "${aws_db_instance.appdb.endpoint}"
        }, {
          name = "DATABASE_NAME"
          value = "appdb"
        }, {
          name = "DATABASE_PORT"
          value = "5432"
        }]
      essential = true
      image = "${data.terraform_remote_state.project.outputs.ecr_repository_web_url}:0.0.1"
      name = "web"
      secrets = [{
          name = "DATABASE_PASSWORD"
          valueFrom = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/docex_smoke_elastic/stage/POSTGRES_PASSWORD"
        }, {
          name = "DATABASE_USER"
          valueFrom = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/docex_smoke_elastic/stage/POSTGRES_USER"
        }]
    },
  ])
  tags = { project = "docex_smoke_elastic", env = "stage", service = "web", role = "migrate", managed_by = "doctrine" }
}

resource "aws_lb_target_group" "web" {
  name        = "docex-smoke-elastic-stage-web-tg"
  port        = 8080
  protocol    = "HTTP"
  target_type = "ip"
  vpc_id      = data.terraform_remote_state.project.outputs.vpc_id
}

resource "aws_lb_listener_rule" "web" {
  listener_arn = aws_lb_listener.alb_https.arn
  priority     = 100
  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.web.arn
  }
  condition {
    host_header {
      values = ["stage.doctrine-elastic.luxrnd.tech", "web.stage.doctrine-elastic.luxrnd.tech"]
    }
  }
}

resource "aws_ecs_service" "web" {
  name            = "docex_smoke_elastic_stage_web"
  cluster         = aws_ecs_cluster.cluster.id
  task_definition = aws_ecs_task_definition.web.arn
  launch_type     = "FARGATE"
  desired_count   = 1
  network_configuration {
    subnets         = data.terraform_remote_state.project.outputs.private_subnet_ids
    security_groups = [aws_security_group.internal.id, aws_security_group.web.id]
  }
  load_balancer {
    target_group_arn = aws_lb_target_group.web.arn
    container_name   = "web"
    container_port   = 8080
  }
}

resource "aws_ecs_task_definition" "worker" {
  family                   = "docex_smoke_elastic_stage_worker"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "256"
  memory                   = "512"
  execution_role_arn       = data.terraform_remote_state.project.outputs.task_execution_role_arn
  ephemeral_storage {
    size_in_gib = 24
  }
  container_definitions = jsonencode([
    {
      environment = [{
          name = "DATABASE_HOST"
          value = "${aws_db_instance.appdb.endpoint}"
        }, {
          name = "DATABASE_NAME"
          value = "appdb"
        }, {
          name = "DATABASE_PORT"
          value = "5432"
        }]
      essential = true
      image = "${data.terraform_remote_state.project.outputs.ecr_repository_worker_url}:0.0.1"
      name = "worker"
      secrets = [{
          name = "DATABASE_PASSWORD"
          valueFrom = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/docex_smoke_elastic/stage/POSTGRES_PASSWORD"
        }, {
          name = "DATABASE_USER"
          valueFrom = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/docex_smoke_elastic/stage/POSTGRES_USER"
        }]
    },
  ])
  tags = { project = "docex_smoke_elastic", env = "stage", service = "worker", role = "web", managed_by = "doctrine" }
}

resource "aws_ecs_service" "worker" {
  name            = "docex_smoke_elastic_stage_worker"
  cluster         = aws_ecs_cluster.cluster.id
  task_definition = aws_ecs_task_definition.worker.arn
  launch_type     = "FARGATE"
  desired_count   = 1
  network_configuration {
    subnets         = data.terraform_remote_state.project.outputs.private_subnet_ids
    security_groups = [aws_security_group.internal.id]
  }
}



# ---------------------------------------------------------------------------
# Route53 record: <env-subdomain> -> ALB
# ---------------------------------------------------------------------------
resource "aws_route53_record" "env" {
  zone_id = data.terraform_remote_state.project.outputs.zone_id
  name    = "stage.doctrine-elastic.luxrnd.tech"
  type    = "A"
  alias {
    name                   = aws_lb.alb.dns_name
    zone_id                = aws_lb.alb.zone_id
    evaluate_target_health = false
  }
}

# Per-service subdomains (<service>.stage.doctrine-elastic.luxrnd.tech) all resolve to the
# same ALB; the listener rules dispatch by host header. One wildcard record
# covers every web service in this env.
resource "aws_route53_record" "env_wildcard" {
  zone_id = data.terraform_remote_state.project.outputs.zone_id
  name    = "*.stage.doctrine-elastic.luxrnd.tech"
  type    = "A"
  alias {
    name                   = aws_lb.alb.dns_name
    zone_id                = aws_lb.alb.zone_id
    evaluate_target_health = false
  }
}
