# Generated by `docex compile`. Do not edit by hand.
# Documents every runtime env var the project's services require.
# Copy this to <env>.env in this directory and fill in real values.

# Doctrine-injected secrets
# The OTel collector sidecar's authentication key against
# observability_backend_url. Required in stage/prod; sidecars in
# dev/test use the `debug` exporter (stdout) and ignore this key.
TELEMETRY_API_KEY=

# appdb (postgres)
# The password of the postgres user
POSTGRES_PASSWORD=
# The username of the postgres user
POSTGRES_USER=
