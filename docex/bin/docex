#!/usr/bin/env bash
# docex shim — checked into every project at ./bin/docex.
#
# The shim is permanent. It is identical across all docex versions —
# only the image tag (read from project.yml's docex_version) changes
# when a project upgrades. New mounts are added here once and apply
# everywhere going forward.

set -euo pipefail

find_project_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/project.yml" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  echo "error: no project.yml found in $PWD or any parent directory" >&2
  exit 1
}

PROJECT_ROOT="$(find_project_root)"

# Read docex_version. Plain grep + sed avoids requiring yq on the host.
DOCEX_VERSION="$(grep -E '^docex_version:' "$PROJECT_ROOT/project.yml" \
  | sed -E 's/^docex_version:[[:space:]]*"?([^"]+)"?[[:space:]]*$/\1/')"

if [[ -z "$DOCEX_VERSION" ]]; then
  echo "error: docex_version not set in $PROJECT_ROOT/project.yml" >&2
  exit 1
fi

# Mount the project at the *same host path* inside the container.
#
# Under DooD (docex's containers spawn sibling containers on the host
# daemon), the path a bind-mount source points at must exist BOTH where
# docex reads it (inside docex's container) and where the host daemon
# looks for it (on the host filesystem). Mirroring the host path —
# rather than mounting to a fixed in-container path like /project —
# makes those two contexts agree:
#
#   - Compose's build contexts resolve to paths the in-container
#     compose client can read.
#   - Compose's bind-mount sources resolve to paths the host docker
#     daemon can find.
#   - Migration paths and similar follow the same logic.
#
# `getpwuid()` resolution also relies on /etc/passwd reporting a home
# dir that matches a real, traversable in-container path; that's why
# credential mounts (~/.aws, ~/.docker, ~/.gitconfig, ~/.ssh) also live
# at the host's HOME path inside the container.
MOUNTS=(
  -v "$PROJECT_ROOT:$PROJECT_ROOT"
  -v "/etc/passwd:/etc/passwd:ro"
  -v "/etc/group:/etc/group:ro"
)
[[ -S "/var/run/docker.sock" ]] && MOUNTS+=(-v "/var/run/docker.sock:/var/run/docker.sock")
# The docker CLI writes runtime state into ~/.docker (buildx builder
# definitions, credential helper cache, etc.) so this mount is rw, not
# ro. Permissions align because the in-container uid matches the host
# uid that owns ~/.docker. Ensure the directory exists on the host so
# the bind has a real source — otherwise docker would silently create
# an empty root-owned dir on the host side.
mkdir -p "$HOME/.docker"
MOUNTS+=(-v "$HOME/.docker:$HOME/.docker")
# F6 (mod 053): ansible writes local state (cp_local, fact cache, etc.)
# under ~/.ansible during `release`. Mirror the ~/.docker treatment so
# the bind has a real, writable source on the host instead of ansible
# warning "Failed to create /home/<user>/.ansible".
mkdir -p "$HOME/.ansible"
MOUNTS+=(-v "$HOME/.ansible:$HOME/.ansible")
[[ -d "$HOME/.aws" ]] && MOUNTS+=(-v "$HOME/.aws:$HOME/.aws:ro")
[[ -f "$HOME/.gitconfig" ]] && MOUNTS+=(-v "$HOME/.gitconfig:$HOME/.gitconfig:ro")
[[ -d "$HOME/.ssh" ]] && MOUNTS+=(-v "$HOME/.ssh:$HOME/.ssh:ro")

# Run flags. The container runs as the host's uid:gid so any files
# docex writes into the project tree end up owned by the operator on
# the host instead of root. HOME mirrors the host so credential
# lookups (passwd-driven for ssh, env-driven for git/aws/docker) all
# agree. WORKDIR mirrors the host path so docex's `os.getcwd()`
# matches what the operator sees on the host.
RUN_FLAGS=(
  --rm
  --user "$(id -u):$(id -g)"
  -e "HOME=$HOME"
  -w "$PROJECT_ROOT"
)

# DooD socket access: when we run as a non-root user, we lose root's
# implicit access to /var/run/docker.sock. The socket is owned by the
# docker group on the host; --group-add lets the in-container user
# join that group at runtime without needing it in /etc/group inside
# the image.
if [[ -S "/var/run/docker.sock" ]]; then
  DOCKER_SOCK_GID="$(stat -c '%g' /var/run/docker.sock)"
  RUN_FLAGS+=(--group-add "$DOCKER_SOCK_GID")
fi

# ssh-agent forwarding: when the operator's SSH key only lives in
# ssh-agent (no key file on disk), mounting ~/.ssh isn't enough — the
# container needs to reach the agent socket. We forward the host's
# $SSH_AUTH_SOCK to a fixed path and tell the in-container ssh to use
# it. Skipped silently when SSH_AUTH_SOCK is unset (no agent in use).
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
  MOUNTS+=(-v "$SSH_AUTH_SOCK:/ssh-agent.sock")
  RUN_FLAGS+=(-e "SSH_AUTH_SOCK=/ssh-agent.sock")
fi

# Host-resolved git credentials (opt-in; mod 061).
#
# The static credential mounts above (~/.gitconfig, ~/.ssh, ssh-agent)
# cover environments where git auth is a file or an agent key. They do
# NOT cover an environment whose git auth is brokered by a
# `credential.helper` talking to a host-local daemon/socket — the helper
# binary and its transport don't exist inside the container. For those
# environments, resolve the credential HERE, on the host (where git's
# own credential machinery — whatever it is — works), and inject the
# result into the container as a short-lived `store`-helper credential.
#
# WHY here, not in docex: the shim is the only host-side step, and only
# the credential *resolution* needs the host. docex's in-container git is
# unchanged. This is general — it drives `git credential fill`, not any
# specific helper — so docex stays agnostic to how the host brokers git.
#
# Opt-in via $DOCEX_GIT_CREDENTIAL_PASSTHROUGH, set by the ENVIRONMENT
# (e.g. a dev-box image), never by the project repo. Unset ⇒ this block
# is skipped entirely and behavior is identical to the static path above.
if [[ -n "${DOCEX_GIT_CREDENTIAL_PASSTHROUGH:-}" ]]; then
  ORIGIN_URL="$(git -C "$PROJECT_ROOT" remote get-url origin 2>/dev/null || true)"
  # Only https origins use a credential helper; ssh / remoteless fall
  # through to the static path unchanged.
  if [[ "$ORIGIN_URL" == https://* ]]; then
    # Drive the host's configured credential machinery non-interactively;
    # GIT_TERMINAL_PROMPT=0 makes a miss fail fast instead of prompting.
    CRED_FILL="$(printf 'url=%s\n\n' "$ORIGIN_URL" \
      | GIT_TERMINAL_PROMPT=0 git -C "$PROJECT_ROOT" credential fill 2>/dev/null || true)"
    CRED_PROTOCOL="$(sed -n 's/^protocol=//p' <<<"$CRED_FILL" | head -n1)"
    CRED_HOST="$(sed -n 's/^host=//p' <<<"$CRED_FILL" | head -n1)"
    CRED_USER="$(sed -n 's/^username=//p' <<<"$CRED_FILL" | head -n1)"
    CRED_PASS="$(sed -n 's/^password=//p' <<<"$CRED_FILL" | head -n1)"
    # Fail open: nothing resolved ⇒ inject nothing, let docex proceed as
    # it would have (it surfaces its own auth error if it needs one).
    if [[ -n "$CRED_USER" && -n "$CRED_PASS" ]]; then
      # Mount a DIRECTORY, not the file directly. On a successful auth git
      # invokes the `store` helper's `store` action, which writes the file
      # atomically (temp + rename onto the target). Renaming onto a
      # single-file bind mount fails ("unable to write credential store:
      # Operation not permitted") because the target is a mountpoint;
      # mounting the containing dir lets the rename happen within it. The
      # dir is mode 700 (umask), owned by the uid the container runs as,
      # and removed on exit.
      CRED_DIR="$(umask 077 && mktemp -d "${TMPDIR:-/tmp}/docex-gitcred.XXXXXX")"
      CRED_FILE="$CRED_DIR/credentials"
      # shellcheck disable=SC2064 - expand CRED_DIR now, at trap-set time.
      trap "rm -rf '$CRED_DIR'" EXIT
      # git `store` line format; no path component ⇒ matches any path on host.
      ( umask 077; printf '%s://%s:%s@%s\n' \
          "$CRED_PROTOCOL" "$CRED_USER" "$CRED_PASS" "$CRED_HOST" >"$CRED_FILE" )
      MOUNTS+=(-v "$CRED_DIR:$CRED_DIR")
      # Reset any inherited credential.helper (e.g. one named in the
      # mounted ~/.gitconfig that can't run in-container) so only our
      # store helper is consulted, and force useHttpPath=false so the
      # host-level (pathless) store entry matches regardless of any
      # inherited per-host useHttpPath=true. GIT_CONFIG_* applies after
      # the config files, so the empty reset clears file-level helpers.
      RUN_FLAGS+=(
        -e GIT_CONFIG_COUNT=3
        -e GIT_CONFIG_KEY_0=credential.helper -e GIT_CONFIG_VALUE_0=
        -e GIT_CONFIG_KEY_1=credential.helper -e "GIT_CONFIG_VALUE_1=store --file=$CRED_FILE"
        -e GIT_CONFIG_KEY_2=credential.useHttpPath -e GIT_CONFIG_VALUE_2=false
      )
      echo "docex: using host-resolved git credentials for $CRED_HOST" >&2
    fi
  fi
fi

exec docker run \
  "${RUN_FLAGS[@]}" \
  "${MOUNTS[@]}" \
  "docex:$DOCEX_VERSION" \
  "$@"
