# Placeholder secrets for the elastic fixture's prod env.
# No POSTGRES_* — engine credentials are minted TTE, pushed to SSM by docex
# itself (put-if-absent); a copy here would collide with the minted key.
#
# TELEMETRY_API_KEY is a doctrine-injected required secret; the mod-091
# release-time required-secret guard aborts a stage/prod release if it is unset.
TELEMETRY_API_KEY=placeholder-prod-telemetry-key
