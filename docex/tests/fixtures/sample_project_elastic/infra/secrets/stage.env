# Placeholder secrets for the elastic fixture's stage env.
# On elastic, ``docex release stage`` pushes the three configurable-value
# categories to SSM under /<project>/stage/<KEY>: secrets from this file as
# SecureString, config as String, and minted TTE (e.g. POSTGRES_PASSWORD)
# put-if-absent as SecureString.
# WHY no POSTGRES_* here: engine credentials are minted TTE — docex owns and
# pushes them to SSM itself; a copy in this file would collide with the
# minted key and trip aggregate_elastic's disjointness guard.
# REAL projects MUST gitignore <env>.env files — these committed values
# exist only so docex's release/migrate code paths have a file to read when
# exercising this fixture under tests.
#
# TELEMETRY_API_KEY is a doctrine-injected required secret; the mod-091
# release-time required-secret guard aborts a stage/prod release if it is unset.
TELEMETRY_API_KEY=placeholder-stage-telemetry-key
