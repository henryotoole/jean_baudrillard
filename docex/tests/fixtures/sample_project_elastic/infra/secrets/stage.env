# Placeholder secrets for the elastic fixture's stage env.
# On elastic, ``docex release stage`` pushes each KEY=VALUE pair to
# SSM Parameter Store under /<project>/stage/<KEY> as a SecureString.
# REAL projects MUST gitignore <env>.env files — these committed
# values exist only so docex's release/migrate code paths have an
# env file to read when exercising this fixture under tests.
POSTGRES_USER=sample
POSTGRES_PASSWORD=sample-stage-password
POSTGRES_DB=sample
